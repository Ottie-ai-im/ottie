<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 / Node JIT needs writable+executable pages. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-executable-page-protection</key>
  <true/>

  <!-- The bundled Node loads .node / .dylib modules signed by other teams
       (better-sqlite3, sherpa-onnx, onnxruntime, the Anthropic claude
       binary). Library Validation must be disabled for dyld to allow them. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- node-pty / spawn rely on env passthrough. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
