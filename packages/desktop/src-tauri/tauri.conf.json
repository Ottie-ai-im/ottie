{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ottie",
  "version": "0.0.1",
  "identifier": "com.ottie.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ottie",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/ottie-daemon"
    ]
  }
}
