{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ottie",
  "version": "1.2.0",
  "identifier": "com.ottie.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ottie/app web",
    "beforeBuildCommand": "pnpm --filter @ottie/app build:web && pnpm -w build:sidecar",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ottie",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/ottie-daemon"],
    "resources": {
      "binaries/resources": "binaries/resources"
    }
  }
}
