{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ottie",
  "version": "1.11.0-beta.1",
  "identifier": "com.ottie.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ottie/app web",
    "beforeBuildCommand": "pnpm --filter @ottie/app build:web && pnpm -w build:sidecar && pnpm -w build:wx-sidecar",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ottie",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0F1110"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/ottie-daemon"],
    "resources": {
      "binaries/resources": "binaries/resources"
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: DIGITAL PULSE LLC (NYJ9G8WDLK)",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    }
  }
}
